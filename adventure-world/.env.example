# Adventure World - Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adventure_world?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Servers
NEXT_PUBLIC_GAME_SERVER_URL="ws://localhost:2567"
NEXT_PUBLIC_SOCIAL_SERVER_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Game Server
GAME_SERVER_PORT=2567

# Social Server
SOCIAL_SERVER_PORT=3001

# Redis (optional for MVP)
REDIS_URL="redis://localhost:6379"
